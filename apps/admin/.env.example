# apps/admin — Super Admin / SaaS paneli — kopyala: copy .env.example .env.local

# Geliştirme sunucusu portu (ör. 4000)
# DEV_SERVER_PORT=4000

# DEV_SERVER_HOST=127.0.0.1

# DEV_SERVER_STRICT_PORT=0

# API proxy hedefi (apps/api ile aynı port; API .env'de PORT=5000 ise burayı 5000 yapın)
# API_PROXY_TARGET=http://127.0.0.1:3101
